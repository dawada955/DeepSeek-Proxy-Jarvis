# ============================================================
# 🔒 DeepSeek Jarvis Proxy — .gitignore
# 目的：严格防止 API 密钥、账号凭据、运行时数据被上传
# ============================================================

# ===== Python 编译产物 =====
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg
*.manifest
*.spec

# ===== 虚拟环境（每台设备独立） =====
env/
venv/
.venv/
pythonenv/
.env/

# ===== 环境变量（常见 API Key 存放位置） =====
.env
.env.*
!.env.example
!.env.sample

# ===== Node.js =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== IDE / 编辑器（个人配置不入库） =====
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-*

# ============================================================
# 🛡️ 敏感数据防护区
# ============================================================

# --- 鉴权凭证（包含 Bearer Token / Session Cookie）---
auth_config.json
core/auth_config.json
*auth_config*.json
!auth_config.json.example

# --- 文件名包含敏感关键词（通配拦截）---
*credential*
*credentials*
*secret*
*secrets*
*password*
*passwd*
*token*
!auth_config.json.example

# --- 运行时数据库（内含 API Key、用量日志）---
*.db
*.sqlite
*.sqlite3
*-journal
*-wal
*-shm

# --- 浏览器用户数据（含 Cookie / Session / LocalStorage）---
ds_browser_profile/

# --- 加密密钥材料 ---
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.truststore
!env/Lib/site-packages/certifi/cacert.pem

# --- 私密项目文档 ---
DS逆向项目提示词.md

# ============================================================

# ===== 备份 & 临时文件（防止敏感文件被复制后意外入库） =====
*.bak
*.backup
*.old
*.orig
*.tmp
*.temp
*.swp
*.swo
*~

# 压缩包（可能打包了敏感配置）
*.7z
*.tar
*.tar.gz
*.tgz
*.rar
*.zip
!requirements.txt

# ===== 系统文件 =====
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ===== 运行时产物 =====
*.log
*.pid
*.lock
*.dump
dump/
logs/

# ===== Jupyter / 数据科学（如有） =====
.ipynb_checkpoints/
*.ipynb_checkpoints
